# =============================================================================
# Autonomous Multi-Hospital Patient Intake Platform - Environment Template
# =============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
DEBUG=false

# Database Configuration (Relational Core - SQLite for Dev, PostgreSQL for Prod)
DATABASE_URL=sqlite:///./hospital_platform.db

# MongoDB Atlas Document Store (Optional)
MONGODB_URI=
MONGODB_DB_NAME=nexushealth_hospital_db

# AI / LLM Configuration
# Supports OpenAI, Azure OpenAI, or compatible proxy endpoints (e.g., AICredits)
OPENAI_BASE_URL=https://api.aicredits.in/v1
OPENAI_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512

# Telephony & Voice Configuration (Optional / Mockable)
VOICE_SYNTHESIS_ENABLED=true
AUDIO_SAMPLE_RATE=24000
BARGE_IN_THRESHOLD_MS=180
SILENCE_DETECTION_MS=450

# EHR / Healthcare Integration Secrets
MOCK_EHR_ENABLED=true
FHIR_BASE_URL=https://fhir.hospital.org/r4
SMART_AUTH_URL=https://fhir.hospital.org/oauth2/token
SMART_CLIENT_ID=your-client-id-here
SMART_CLIENT_SECRET=your-client-secret-here
EHR_DEFAULT_TIMEOUT_SECONDS=5.0

# Security & Encryption
JWT_SECRET_KEY=generate-a-secure-random-secret-key-32-chars
JWT_ALGORITHM=HS256
DATA_ENCRYPTION_KEY=32-character-encryption-key-here
SECRETS_VAULT_KEY=vault-master-key-here

# Notification Services (Mockable for local development)
SMS_GATEWAY_API_KEY=your-sms-api-key
EMAIL_SMTP_HOST=smtp.hospital.org
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=no-reply@hospital.org
EMAIL_SMTP_PASS=smtp-password-here
